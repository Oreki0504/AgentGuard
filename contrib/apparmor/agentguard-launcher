# Debian/Ubuntu amd64 Phase 2B profile, attached only to the installed launcher.
# Host sources are still authorized and pinned by trusted Runtime configuration.
abi <abi/5.0>,
include <tunables/global>

profile agentguard-launcher /usr/local/libexec/agentguard-launcher flags=(attach_disconnected) {
  userns,
  capability sys_admin,
  capability setpcap,
  signal (send, receive) peer=agentguard-launcher,
  signal (send) peer=agentguard-launcher//workload,
  signal (receive) peer=unconfined,
  /usr/local/libexec/agentguard-launcher rix,
  /proc/ r,
  /proc/** r,
  /proc/[0-9]*/{uid_map,gid_map,setgroups} w,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  /dev/null rw,
  / r,
  /tmp/ r,
  /home/ r,
  owner /tmp/** r,
  owner /home/** r,
  /usr/ r,
  /usr/bin/ r,
  /usr/bin/** r,
  /usr/lib/ r,
  /usr/lib/** mr,
  /lib{,64}/ r,
  /lib{,64}/** mr,
  owner /tmp/agentguard-rootfs-*/ rw,
  owner /tmp/agentguard-rootfs-*/** rw,
  mount options=(rw, rprivate) -> /,
  mount fstype=tmpfs options=(rw, nosuid, nodev) -> /tmp/agentguard-rootfs-*/,
  mount options=(rw, bind) /{home,tmp}/** -> /tmp/agentguard-rootfs-*/**,
  mount options=(rw, remount, bind, nosuid, nodev, noexec) -> /tmp/agentguard-rootfs-*/**,
  mount options=(ro, remount, bind, nosuid, nodev, noexec) -> /tmp/agentguard-rootfs-*/**,
  mount fstype=proc options=(ro, nosuid, nodev, noexec) -> /tmp/agentguard-rootfs-*/proc/,
  mount options=(rw, bind) /dev/null -> /tmp/agentguard-rootfs-*/dev/null,
  mount options=(rw, remount, bind, nosuid, noexec) -> /tmp/agentguard-rootfs-*/dev/null,
  pivot_root oldroot=/tmp/agentguard-rootfs-*/.oldroot/ /tmp/agentguard-rootfs-*/,
  umount /.oldroot/,
  /.oldroot/ w,
  /bin/ r,
  /bin/** rCx -> workload,

  profile workload {
    signal (send, receive) peer=agentguard-launcher//workload,
    signal (receive) peer=agentguard-launcher,
    signal (receive) peer=unconfined,
    / r,
    /bin/ r,
    /bin/** rix,
    /lib{,64}/ r,
    /lib{,64}/** mr,
    /usr/ r,
    /usr/lib/ r,
    /usr/lib/** mr,
    /proc/ r,
    /proc/** r,
    /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
    /dev/null rw,
    /workspace/ rw,
    /workspace/** rw,
    /scratch/ rw,
    /scratch/** rw,
    /tmp/ rw,
    /tmp/** rw,
  }
}
